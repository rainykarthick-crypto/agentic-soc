# ---------------------------------------------------------------------------
# Agentic SOC - environment template. Copy to .env.
# ---------------------------------------------------------------------------

# Where the agent sends its LLM calls.
#
#   http://host.docker.internal:11434/api/generate   reuse an Ollama on the host
#   http://ollama:11434/api/generate                 use the bundled one (--profile llm)
#
# If you run the bundled model server, also pull a model:
#   docker exec soc-ollama ollama pull llama3.2:3b
OLLAMA_URL=http://host.docker.internal:11434/api/generate
